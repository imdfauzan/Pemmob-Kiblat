<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <com.example.sensorkiblat.ThemedTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_sensor"
            android:textSize="34sp"
            android:textStyle="bold" />

        <com.example.sensorkiblat.ThemedTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_sensor"
            android:textSize="15sp"
            app:glassTextRole="secondary" />

        <!-- Kartu utama: ikon matahari/bulan + nilai Lux -->
        <com.example.sensorkiblat.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.example.sensorkiblat.SunMoonView
                    android:layout_width="140dp"
                    android:layout_height="140dp" />

                <com.example.sensorkiblat.ThemedTextView
                    android:id="@+id/tv_lux_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_zero"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <com.example.sensorkiblat.ThemedTextView
                    android:id="@+id/tv_lux"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_lux_zero"
                    android:textSize="15sp"
                    app:glassTextRole="secondary" />

                <com.example.sensorkiblat.GlassCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    app:glassRadius="999dp">

                    <com.example.sensorkiblat.ThemedTextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_status_light_auto"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:glassTextRole="accent" />
                </com.example.sensorkiblat.GlassCardView>

                <com.example.sensorkiblat.LuxGaugeView
                    android:id="@+id/gauge"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp" />
            </LinearLayout>
        </com.example.sensorkiblat.GlassCardView>

        <!-- Kartu mode tema -->
        <com.example.sensorkiblat.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.example.sensorkiblat.ThemedTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/label_mode_theme"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:glassTextRole="secondary" />

                <com.example.sensorkiblat.GlassTabBar
                    android:id="@+id/tab_mode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />

                <com.example.sensorkiblat.ThemedTextView
                    android:id="@+id/tv_mode_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hint_theme_auto"
                    android:textSize="13sp"
                    app:glassTextRole="secondary" />
            </LinearLayout>
        </com.example.sensorkiblat.GlassCardView>

        <!-- Kartu ambang Lux -->
        <com.example.sensorkiblat.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.example.sensorkiblat.ThemedTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/label_lux_threshold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:glassTextRole="secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.example.sensorkiblat.ThemedTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_dark_threshold"
                        android:textSize="15sp" />

                    <com.example.sensorkiblat.ThemedTextView
                        android:id="@+id/tv_dark_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_dark_val"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:glassTextRole="accent" />
                </LinearLayout>

                <com.example.sensorkiblat.GlassSeekBar
                    android:id="@+id/seek_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.example.sensorkiblat.ThemedTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_light_threshold"
                        android:textSize="15sp" />

                    <com.example.sensorkiblat.ThemedTextView
                        android:id="@+id/tv_light_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_light_val"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:glassTextRole="accent" />
                </LinearLayout>

                <com.example.sensorkiblat.GlassSeekBar
                    android:id="@+id/seek_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <com.example.sensorkiblat.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hint_threshold_info"
                    android:textSize="13sp"
                    app:glassTextRole="secondary" />
            </LinearLayout>
        </com.example.sensorkiblat.GlassCardView>

        <!-- Muncul hanya jika HP tidak punya sensor cahaya -->
        <com.example.sensorkiblat.GlassCardView
            android:id="@+id/card_no_sensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:visibility="gone">

            <com.example.sensorkiblat.ThemedTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_sensor"
                android:textSize="14sp"
                app:glassTextRole="accent" />
        </com.example.sensorkiblat.GlassCardView>

    </LinearLayout>
</ScrollView>