<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="glassRadius" format="dimension" />
    <attr name="glassAccent" format="boolean" />

    <declare-styleable name="GlassView">
        <attr name="glassRadius" />
        <attr name="glassAccent" />
    </declare-styleable>

    <declare-styleable name="GlassButton">
        <attr name="glassRadius" />
        <attr name="glassAccent" />
    </declare-styleable>

    <declare-styleable name="GlassCardView">
        <attr name="glassRadius" />
        <attr name="glassAccent" />
    </declare-styleable>

    <declare-styleable name="ThemedTextView">
        <attr name="glassTextRole" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="accent" value="2" />
            <enum name="success" value="3" />
        </attr>
    </declare-styleable>
</resources>